{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "empo hook session-start --repo \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "empo hook pre-edit --repo \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "empo hook pre-commit --repo \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
